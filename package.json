{
  "name": "oncoready-launch-backend",
  "private": true,
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "typecheck:server": "tsc -p packages/server/tsconfig.json --noEmit",
    "build:server": "npm run typecheck:server && tsc -p packages/server/tsconfig.build.json",
    "start:server": "node dist/server/server.js",
    "test:server": "vitest run tests/server tests/contracts tests/fhir",
    "test:security": "vitest run tests/server/security.test.ts tests/server/webhooks.test.ts",
    "test": "npm run typecheck:server && npm run test:server"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "twilio": "^5.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}

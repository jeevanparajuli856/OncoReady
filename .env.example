# Copy to `.env` for local backend work. Never commit real values.
# On Railway, define these on the backend service and seal secret values.
NODE_ENV=development
APP_ENV=development
PORT=3000

# Persistence and controlled-environment boundary
DATABASE_URL=
ONCOREADY_SCENARIO_TOKEN=
ONCOREADY_ALLOWED_ORIGINS=http://localhost:5173
ONCOREADY_PUBLIC_ORIGIN=http://localhost:3000
CRON_SECRET=
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=15000
SCHEDULER_BATCH_SIZE=25

# External actions remain inert until every provider preflight passes.
EXTERNAL_ACTIONS_ENABLED=false
FINALS_ALLOWLISTED_PHONE=

# Twilio SMS
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ElevenLabs voice through the imported Twilio number
ELEVENLABS_VOICE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

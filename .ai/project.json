{
  "schema_version": "1.0",
  "status": "INCEPTION_READY",
  "delivery": {
    "mode": "RAPID_PRODUCT",
    "priorities": [
      "product_experience",
      "end_to_end_functionality",
      "demo_reliability",
      "technical_credibility",
      "delivery_speed"
    ],
    "production_hardening": "RISK_BASED"
  },
  "components": {
    "backend": {
      "enabled": true,
      "path": "api",
      "technology": "TypeScript + Vercel Node.js Functions"
    },
    "frontend": {
      "enabled": true,
      "path": "frontend",
      "technology": "React + TypeScript + Vite"
    },
    "database": {
      "enabled": true,
      "provider": "Supabase PostgreSQL",
      "migration_path": "supabase/migrations"
    }
  },
  "verification": {
    "checks": [
      {
        "name": "governed API and event contracts",
        "command": [
          "python3",
          "scripts/validate-contracts.py"
        ],
        "cwd": ".",
        "required": true
      },
      {
        "name": "server database FHIR and ML runtime tests",
        "command": [
          "npm",
          "run",
          "test:server"
        ],
        "cwd": ".",
        "required": true
      },
      {
        "name": "offline ML artifact reproducibility",
        "command": [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/ml"
        ],
        "cwd": ".",
        "required": true
      },
      {
        "name": "generated frontend API client is current",
        "command": [
          "npm",
          "run",
          "api:check"
        ],
        "cwd": "frontend",
        "required": true
      },
      {
        "name": "frontend build",
        "command": [
          "npm",
          "run",
          "build"
        ],
        "cwd": "frontend",
        "required": true
      },
      {
        "name": "frontend critical-path smoke",
        "command": [
          "npm",
          "run",
          "test:smoke"
        ],
        "cwd": "frontend",
        "required": true
      },
      {
        "name": "frontend full journey browser tests",
        "command": [
          "npm",
          "run",
          "test:e2e"
        ],
        "cwd": "frontend",
        "required": true
      }
    ]
  },
  "security": {
    "checks": [
      {
        "name": "callback authorization and external-action controls",
        "command": [
          "npm",
          "run",
          "test:security"
        ],
        "cwd": ".",
        "required": true
      }
    ]
  }
}

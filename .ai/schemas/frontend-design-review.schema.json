{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontend-design-review.schema.json",
  "title": "Frontend Design Compatibility Review",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "agent",
    "status",
    "summary",
    "review_scope",
    "reviewed_design_sha256",
    "checks",
    "required_changes",
    "notes_for_frontend"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "CHANGES_REQUIRED",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "review_scope": {
      "type": "string"
    },
    "reviewed_design_sha256": {
      "type": "string"
    },
    "checks": {
      "type": "object",
      "required": [
        "requirements",
        "architecture_and_contracts",
        "security_and_authorization",
        "accessibility",
        "performance",
        "scope",
        "human_brand_design_system_constraints"
      ],
      "properties": {
        "requirements": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "architecture_and_contracts": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "security_and_authorization": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "accessibility": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "performance": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "human_brand_design_system_constraints": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        }
      },
      "additionalProperties": false
    },
    "required_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "description"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "requirements",
              "architecture_contract",
              "security_authorization",
              "accessibility",
              "performance",
              "scope",
              "human_brand_design_system"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes_for_frontend": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reviewed_design_sha256": {
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}

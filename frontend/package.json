{
  "name": "oncoready-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated.ts",
    "api:check": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated.ts --check",
    "preview": "vite preview",
    "test:smoke": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tabler/icons-react": "^3.46.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotted-map": "^3.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  }
}
